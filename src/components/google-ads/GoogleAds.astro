---
// Services section with 4-column grid and lime icons
---

<section id="services" class="py-6 md:py-18 bg-surface">
  <div class="max-w-5xl mx-auto px-6 py-6 text-left">

    <h2 class="text-[30px] md:text-[40px] text-primary uppercase text-center font-semibold m-0">
      Skyrocket Your Sales With Google Ads
    </h2>
    
    <p class="text-[15px] md:text-[20px] font-normal text-foreground mt-2">
      Your ideal customer is on Google and so is your competition. We can create laser targeted Google Ad campaigns that will flood your business with new profitable clients.
    </p>

    <p class="text-[15px] md:text-[20px] font-normal text-foreground mt-4">
      Most agencies focus on traffic while we focus on results. At Lime Media we care about one thing and one thing only - ROI. If your campaign isn't profitable then we don't get paid. We are long term driven, therefore we are super selective on the campaigns we take on to ensure that we give our clients the transparency and honesty to foster these relationships.
    </p>

   <div class="grid grid-cols-1 md:grid-cols-2 gap-0 w-full max-w-6xl mx-auto">
      <div class="flex flex-col items-center gap-1">
        <div class="mt-4">
          <h3 class="text-[22px] font-semibold text-primary mt-3">WHY GOOGLE ADS?</h3>
          <ul class="list-disc list-inside space-y-2 mt-4 text-[18px] font-normal text-foreground">
            <li>Reach your ideal customer</li>
            <li>Consistent new leads</li>
            <li>Grow your business instantly</li>
            <li>Improve your overall ROI</li>
            <li>Surge your top and bottom lines</li>
          </ul>
        </div>
      </div>

      <div class="flex flex-col items-center gap-1">
        <div class="mt-4">
          <img src="/img/google.png">
        </div>
      </div>
    </div>

    <div class="grid grid-cols-3 md:grid-cols-3 gap-0 w-full max-w-6xl mx-auto mt-10">
      <div class="flex flex-col items-center gap-1">
        <h3 class="text-[20px] font-light text-foreground mt-3 mb-3">YEARS EXPERIENCE</h3>
        <div class="w-[120px] h-[120px] shrink-0 rounded-full text-2xl font-bold bg-primary text-white flex items-center justify-center">
          14
        </div>
      </div>
      <div class="flex flex-col items-center gap-1">
        <h3 class="text-[20px] font-light text-foreground mt-3 mb-3">AVERAGE ROI</h3>
        <div class="w-[120px] h-[120px] shrink-0 rounded-full text-2xl font-bold bg-primary text-white flex items-center justify-center">
          358%
        </div>
      </div>

      <div class="flex flex-col items-center gap-1">
        <h3 class="text-[20px] font-light text-foreground mt-3 mb-3">SETUP FEES</h3>
        <div class="w-[120px] h-[120px] shrink-0 rounded-full text-2xl font-bold bg-primary text-white flex items-center justify-center">
          $0
        </div>
      </div>
    </div>

    <div class="">
      <h3 class="text-[26px] font-bold text-primary text-center mt-15">SCHEDULE A FREE 30 MINUTE STRATEGY</h3>
      <div class="bg-white w-full md:w-[60%] mx-auto px-6 py-6 mt-8 shadow-md">
        <form 
          id="gads-form"
          class="
            w-full
            flex flex-col gap-4 
            text-left 
            mt-8
          "
        >
          <input 
            type="text" 
            placeholder="Name" 
            name="name"
            class="
              p-4 
              border border-[#cccccc] outline-none focus:border-primary
              bg-white 
              text-[16px] font-normal
              transition-colors 
              placeholder:text-gray-400
            " 
            required 
          />

          <input 
            type="text" 
            placeholder="Company" 
            name="company"
            class="
              p-4 
              border border-[#cccccc] outline-none focus:border-primary
              bg-white 
              text-[16px] font-normal
              transition-colors 
              placeholder:text-gray-400
            " 
            required 
          />

          <input 
            type="tel" 
            placeholder="Telephone" 
            name="telephone"
            class="
              p-4 
              border border-[#cccccc] outline-none focus:border-primary
              bg-white 
              text-[16px] font-normal
              transition-colors 
              placeholder:text-gray-400
            " 
            required 
          />

          <input 
            type="email" 
            placeholder="Email Address" 
            name="email"
            class="
              p-4 
              border border-[#cccccc] outline-none focus:border-primary
              bg-white 
              text-[16px] font-normal
              transition-colors 
              placeholder:text-gray-400
            " 
            required 
          />

          <input 
            type="text" 
            placeholder="Budget" 
            name="budget"
            class="
              p-4 
              border border-[#cccccc] outline-none focus:border-primary
              bg-white 
              text-[16px] font-normal
              transition-colors 
              placeholder:text-gray-400
            " 
            required 
          />

          <textarea 
            placeholder="Message" 
            name="message"
            rows="6" 
            class="
              p-4 
              border border-[#cccccc] outline-none focus:border-primary
              bg-white 
              text-[16px] font-normal
              transition-colors 
              placeholder:text-gray-400
              resize-none
            " 
            required></textarea>

          <button 
            type="submit" 
            name="gads-form"
            class="
              bg-primary 
              text-white 
              py-4 
              uppercase 
              text-[18px] font-semibold 
              border-none 
              cursor-pointer 
              hover:bg-primary-hover 
              transition-colors
            "
          >
            SUBMIT
          </button>

          <!-- Success message -->
          <div
            id="gads-success"
            class="hidden p-4 bg-green-100 border border-green-300 text-green-700 text-center"
            role="alert"
          >
            Thank you. We have received your request and will be in contact shortly.
          </div>      

          <!-- Error message -->
          <div
            id="gads-error"
            class="hidden p-4 bg-red-100 border border-red-300 text-red-700 text-center"
            role="alert"
          >
            Something went wrong. Please try again.
          </div>      
        </form>

        <script is:inline>
          const form = document.querySelector("#gads-form");
          const successMessage = document.querySelector("#gads-success");
          const errorMessage = document.querySelector("#gads-error");

          form?.addEventListener("submit", async (event) => {
            event.preventDefault();

            const button = form.querySelector('button[type="submit"]');

            // Hide previous messages
            successMessage?.classList.add("hidden");
            errorMessage?.classList.add("hidden");

            if (button) {
              button.disabled = true;
              button.textContent = "SENDING...";
            }

            try {
              const formData = new FormData(form);

              // Change this to your webhook URL
              const response = await fetch("https://n8n.limemedia.co.za/webhook/limeagency", { // Notify on Slack (via n8n)
                method: "POST", 
                headers: { 
                  "Content-Type": "application/json", 
                }, 
                body: JSON.stringify({ 
                  name: formData.get("name"), 
                  company: formData.get("company"), 
                  telephone: formData.get("telephone"), 
                  email: formData.get("email"), 
                  budget: formData.get("budget"), 
                  message: formData.get("message"), 
                }), 
              });

              // For now, simulate a successful submission
              await new Promise((resolve) => setTimeout(resolve, 1000));

              if (!response.ok) { 
                throw new Error(`Webhook returned ${response.status}`); 
              }

              // Webhook succeeded
              form.reset();
              successMessage?.classList.remove("hidden");
            } catch (error) {
              console.error("Form submission failed:", error);
              
              // Webhook failed
              errorMessage?.classList.remove("hidden");
            } finally { 
              if (button) { 
                button.disabled = false; 
                button.textContent = "SUBMIT"; 
              } 
            }
          });
        </script>
      </div>
    </div>

    <div class="w-full mt-20">
      <div class="mx-auto grid max-w-[1025px] grid-cols-1 bg-white shadow-md md:grid-cols-2">

        <!-- Left image -->
        <div class="hidden md:block">
          <img
            src="/img/social.jpeg"
            alt="Google Ads case studies"
            class="h-full w-full object-cover"
          />
        </div>

        <!-- Right content -->
        <div class="flex flex-col justify-center px-8 py-12 md:px-12">
          
          <p class="mb-4 text-left text-sm font-bold tracking-wide">
            GOOGLE ADS CASE STUDIES
          </p>

          <p class="mb-8 text-left text-base leading-relaxed text-gray-700">
            Download our latest case studies on Google Ad campaigns where we
            managed to scale some of our campaigns by more than 600%
          </p>

          <div>
            <a
              href="https://limemedia.co.za/wp-content/uploads/2022/10/Google-Ads-Case-Study.pdf"
              class="inline-flex items-center gap-3 bg-primary px-6 py-3 text-sm font-bold text-white transition-all hover:opacity-90"
            >
              <svg
                class="h-5 w-5 fill-current"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M17 13l-5 5-5-5h3V9h4v4h3zm2.35-2.97C18.67 6.59 15.64 4 12 4c-2.89 0-5.4 1.64-6.65 4.03C2.34 8.36 0 10.9 0 14a6 6 0 006 6h13a5 5 0 005-5c0-2.64-2.05-4.78-4.65-4.97z" />
              </svg>

              <span>DOWNLOAD</span>
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
