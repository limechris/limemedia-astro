---
// Navigation - updated to match Lime Media design
import { SITE } from '@/config/site';

export interface Props {
  logo?: string;
}

const { logo = "https://limemedia.co.za/wp-content/uploads/2022/01/limemedia.png" } = Astro.props;
---

<header id="navbar" class="bg-background" data-ps="src/components/Navigation.astro:dt8k86">
  <nav class="py-6" data-ps="src/components/Navigation.astro:m59h3b">
    <div class="max-w-7xl mx-auto px-6 flex justify-between items-center" data-ps="src/components/Navigation.astro:gqvsdb">
      <a href="/" class="no-underline" data-ps="src/components/Navigation.astro:kd8n5y">
        <img src={logo} alt={SITE.name} class="h-[40px] w-auto" data-ps="src/components/Navigation.astro:logo-img" />
      </a>

      <div class="flex items-center gap-6" data-ps="src/components/Navigation.astro:gqvsdc">
        <div class="hidden md:flex gap-8 items-center" data-ps="src/components/Navigation.astro:gqvsdd">
          <a href="/" class="text-[14px] uppercase font-normal text-foreground no-underline border-b-2 border-primary transition-colors" data-ps="src/components/Navigation.astro:link-home">Home</a>
          <div class="group relative py-2" data-ps="src/components/Navigation.astro:dropdown">
            <a href="/services/" class="text-[14px] uppercase font-normal text-foreground no-underline hover:border-b-2 hover:border-primary transition-all flex items-center gap-1" data-ps="src/components/Navigation.astro:link-services">
              Services
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </a>
            <div class="absolute left-0 top-full w-48 bg-background border border-border hidden group-hover:block z-50 shadow-lg" data-ps="src/components/Navigation.astro:gqvsde">
              <a href="/lead-generation/" class="block px-4 py-2 text-sm no-underline text-foreground hover:bg-surface transition-colors" data-ps="src/components/Navigation.astro:kd8n5u">Lead Generation</a>
              <a href="/google-ads/" class="block px-4 py-2 text-sm no-underline text-foreground hover:bg-surface transition-colors" data-ps="src/components/Navigation.astro:kd8n5t">Google Ads</a>
              <a href="/consulting/" class="block px-4 py-2 text-sm no-underline text-foreground hover:bg-surface transition-colors" data-ps="src/components/Navigation.astro:kd8n5s">Consulting</a>
            </div>
          </div>
          <a href="/#contact" class="text-[14px] uppercase font-normal text-foreground no-underline hover:border-b-2 hover:border-primary transition-all" data-ps="src/components/Navigation.astro:link-contact">Contact</a>
        </div>

        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden p-2 text-foreground hover:text-primary transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
         data-ps="src/components/Navigation.astro:5ds1">
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="hidden md:hidden overflow-hidden bg-background border-t border-border"
    role="navigation"
    aria-label="Mobile navigation"
   data-ps="src/components/Navigation.astro:gqvsde">
    <nav class="flex flex-col py-4 px-6 gap-2" data-ps="src/components/Navigation.astro:m59h37">
      <a href="/" class="text-[14px] uppercase font-normal py-3 no-underline text-foreground border-b border-border" data-ps="src/components/Navigation.astro:kd8n5w">Home</a>
      <a href="/services/" class="text-[14px] uppercase font-normal py-3 no-underline text-foreground border-b border-border" data-ps="src/components/Navigation.astro:mob-services">Services</a>
      <a href="/#contact" class="text-[14px] uppercase font-normal py-3 no-underline text-foreground" data-ps="src/components/Navigation.astro:mob-contact">Contact</a>
    </nav>
  </div>
</header>

<script is:inline>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  function toggleMenu() {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
    }
  }

  mobileMenuButton?.addEventListener('click', toggleMenu);
</script>
