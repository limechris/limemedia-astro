---
// Services section with 4-column grid and lime icons
---

<section id="services" class="py-6 md:py-18 bg-surface">
  <div class="max-w-5xl mx-auto px-6 py-6 text-center">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 max-w-6xl mx-auto">
      <!-- Lead Generation -->
      <div class="bg-primary p-6 flex flex-col items-center justify-center gap-4">
        <div class="text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 14 14" fill="#ffffff"><g fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round"><path d="M13.48 7.516a6.5 6.5 0 1 1-6.93-7"/><path d="M9.79 8.09A3 3 0 1 1 5.9 4.21M7 7l2.5-2.5m2 .5l-2-.5l-.5-2l2-2l.5 2l2 .5z"/></g></svg>
        </div>
        <h3 class="rounded-full bg-white px-4 py-2 text-[16px] font-semibold text-primary">
          Lead Generation
        </h3>
      </div>

      <!-- Social -->
      <div class="bg-primary p-6 flex flex-col items-center justify-center gap-4">
        <div class="text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 512 384"><path fill="#FFFFFF" d="M85 64v235h214v64H0v-64h43V64q0-18 12.5-30.5T85 21h384v43H85zm406 43q8 0 14.5 6t6.5 15v213q0 9-6.5 15.5T491 363H363q-9 0-15.5-6.5T341 341V128q0-9 6.5-15t15.5-6h128zm-22 192V149h-85v150h85z"/></svg>
        </div>
        <h3 class="rounded-full bg-white px-4 py-2 text-[16px] font-semibold text-primary">
          Social
        </h3>
      </div>

      <!-- Google Ads -->
      <div class="bg-primary p-6 flex flex-col items-center justify-center gap-4">
        <div class="text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24"><path fill="#FFFFFF" d="M12.25 1.47c-.7-.05-1.43.11-2.08.49a3.656 3.656 0 0 0-1.35 5l7.34 12.7c1.01 1.76 3.25 2.34 5.01 1.34c1.75-1 2.33-3.25 1.33-5L15.18 3.3a3.695 3.695 0 0 0-2.93-1.83M6.82 6.76L1.5 16a3.67 3.67 0 0 0-.5 1.83a3.67 3.67 0 0 0 3.67 3.67a3.67 3.67 0 0 0 3.17-1.84v.01L11 14.19c-1.35-2.3-2.73-4.59-3.97-6.96c-.08-.15-.15-.31-.2-.47ZL16.4 5Z"/></svg>
        </div>
        <h3 class="rounded-full bg-white px-4 py-2 text-[16px] font-semibold text-primary">
          Google Ads
        </h3>
      </div>

      <!-- Consulting -->
      <div class="bg-primary p-6 flex flex-col items-center justify-center gap-4">
        <div class="text-primary">
          <svg  width="64" height="64" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="#ffffff" d="M11 6h3l3.29-3.3a1 1 0 0 1 1.42 0l2.58 2.59a1 1 0 0 1 0 1.41L19 9h-8v2a1 1 0 0 1-1 1a1 1 0 0 1-1-1V8a2 2 0 0 1 2-2m-6 5v4l-2.29 2.29a1 1 0 0 0 0 1.41l2.58 2.59a1 1 0 0 0 1.42 0L11 17h4a1 1 0 0 0 1-1v-1h1a1 1 0 0 0 1-1v-1h1a1 1 0 0 0 1-1v-1h-7v1a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V9Z"/></svg>
        </div>
        <h3 class="rounded-full bg-white px-4 py-2 text-[16px] font-semibold text-primary">
          Consulting
        </h3>
      </div>
    </div>
  </div>
</section>
