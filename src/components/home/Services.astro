---
// Services section with 4-column grid and lime icons
---

<section id="services" class="py-24 bg-surface" data-ps="src/components/home/Services.astro:services-sec">
  <div class="max-w-7xl mx-auto px-6 text-center" data-ps="src/components/home/Services.astro:container">
    <h2 class="text-[40px] font-normal m-0" data-ps="src/components/home/Services.astro:title">
      Where We <span class="text-accent" data-ps="src/components/home/Services.astro:krszh0">Excel</span>
    </h2>
    <p class="text-[18px] font-light text-foreground mt-4 mb-16" data-ps="src/components/home/Services.astro:subtitle">
      At Lime Media we are results driven and these are the areas where we excel:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 max-w-6xl mx-auto" data-ps="src/components/home/Services.astro:grid">
      <!-- Lead Generation -->
      <div class="flex flex-col items-center gap-4" data-ps="src/components/home/Services.astro:item-1">
        <h3 class="text-sm font-normal text-dark uppercase tracking-wider" data-ps="src/components/home/Services.astro:h1">Lead Generation</h3>
        <div class="text-primary" data-ps="src/components/home/Services.astro:i1">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
      </div>

      <!-- Social -->
      <div class="flex flex-col items-center gap-4" data-ps="src/components/home/Services.astro:item-2">
        <h3 class="text-sm font-normal text-dark uppercase tracking-wider" data-ps="src/components/home/Services.astro:h2">Social</h3>
        <div class="text-primary" data-ps="src/components/home/Services.astro:i2">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 21h6l-.75-4M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
      </div>

      <!-- Google Ads -->
      <div class="flex flex-col items-center gap-4" data-ps="src/components/home/Services.astro:item-3">
        <h3 class="text-sm font-normal text-dark uppercase tracking-wider" data-ps="src/components/home/Services.astro:h3">Google Ads</h3>
        <div class="text-primary" data-ps="src/components/home/Services.astro:i3">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3" /></svg>
        </div>
      </div>

      <!-- Consulting -->
      <div class="flex flex-col items-center gap-4" data-ps="src/components/home/Services.astro:item-4">
        <h3 class="text-sm font-normal text-dark uppercase tracking-wider" data-ps="src/components/home/Services.astro:h4">Consulting</h3>
        <div class="text-primary" data-ps="src/components/home/Services.astro:i4">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        </div>
      </div>
    </div>
  </div>
</section>
