  class="relative py-22 flex items-center justify-center text-center bg-cover bg-center" 
  style="background-image: url('https://limemedia.co.za/wp-content/uploads/2022/01/architecture-featured.jpg');"
>
  <div class="absolute inset-0 bg-white/90"></div>
  
  <div class="relative z-10 max-w-4xl mx-auto px-6 flex flex-col items-center gap-6">
