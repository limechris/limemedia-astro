---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PPHero from '@/components/privacy-policy/PPHero.astro';
import PP from '@/components/privacy-policy/PP.astro'
import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Privacy Policy - Lime Media",
  "description": "limemedia.co.za, managed by LIME HOLDINGS (Pty) Ltd, based in Cape Town, South Africa, is committed to protecting the privacy of our online visitors in compliance with the Protection of Personal Information Act (POPIA) and other relevant privacy laws.",
  "url": SITE.url,
  "logo": "https://limemedia.co.za/wp-content/uploads/2022/01/limemedia.png"
};
---

<BaseLayout 
  title={SITE.title}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <PPHero />
  <PP />
</BaseLayout>