---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title={`Page Not Found – ${SITE.name}`}
  description="The page you requested could not be found."
>
  <div class="mx-auto flex max-w-3xl flex-col items-center px-6 py-24 text-center">
    <p class="mb-4 text-sm font-semibold text-primary">404</p>
    <h1 class="mb-4 text-4xl font-bold tracking-tight md:text-5xl">Page not found</h1>
    <p class="mb-8">Sorry, we couldn't find the page you're looking for.</p>
    <div class="flex gap-3">
      <a href="/" class="rounded-md bg-primary px-4 py-2 text-primary-foreground shadow transition-colors hover:bg-primary-hover">Go back home</a>
    </div>
  </div>
</BaseLayout>
