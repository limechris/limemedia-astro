---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ConsultingHero from '@/components/consulting/ConsultingHero.astro';
import Consulting from '@/components/consulting/Consulting.astro'
import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Consulting - Lime Media",
  "description": "One-On-One consulting Let's face it - there are millions of digital marketers out there. You can pay for consultations from most of them for a fraction of the cost of what we charge at Lime Media (yes we are very blunt).",
  "url": SITE.url,
  "logo": "https://limemedia.co.za/wp-content/uploads/2022/01/limemedia.png"
};
---

<BaseLayout 
  title={SITE.title}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <ConsultingHero />
  <Consulting />
</BaseLayout>